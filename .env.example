# ============================================================
# TARJUMAN — Environment Variables
# Copy this to .env.local and fill in real values
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google OAuth (configure in Supabase Auth settings) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Stripe Price IDs (create in Stripe Dashboard) ---
NEXT_PUBLIC_STRIPE_PRICE_BASIC=price_...     # $29 Submission Only
NEXT_PUBLIC_STRIPE_PRICE_STANDARD=price_...  # $69 Standard
NEXT_PUBLIC_STRIPE_PRICE_VIP=price_...       # $99 VIP Fast Track

# --- SendGrid (Email notifications) ---
SENDGRID_API_KEY=SG.your-api-key
SENDGRID_FROM_EMAIL=noreply@tarjuman.com
SENDGRID_FROM_NAME=TARJUMAN

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# --- CIS Payment Gateway (Payme / Click — Uzbekistan) ---
# Plug in your provider credentials here
CIS_PAYMENT_MERCHANT_ID=
CIS_PAYMENT_SECRET_KEY=
CIS_PAYMENT_API_URL=https://checkout.paycom.uz

# --- App ---
NEXT_PUBLIC_APP_URL=https://tarjuman.com
NEXT_PUBLIC_APP_NAME=TARJUMAN
ADMIN_SECRET_KEY=change-this-to-a-strong-random-string

# --- Storage buckets (create in Supabase Storage) ---
# Bucket names: "documents" (private), "avatars" (public)
